    {
      "name": "Users",
      "item": [
        {
          "name": "Email a password reset code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/forgot?apikey={{apikey}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "forgot"
              ],
              "query": [
                {
                  "key": "apikey",
                  "value": "{{apikey}}"
                }
              ]
            },
            "description": "Always answers with the same message, whether or not the email has an account. The code is 6 digits, valid for 15 minutes and works once. One request per minute per account, and 20 per day per developer key.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user1@mail.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
